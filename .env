# ============================================
# DapurGizi — Environment Variables
# ============================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://dapurgizi:dapurgizi_secret@localhost:5432/dapurgizi

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MinIO (Object Storage) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=dapurgizi_minio
MINIO_SECRET_KEY=dapurgizi_minio_secret
MINIO_BUCKET=dapurgizi
MINIO_USE_SSL=false

# --- JWT ---
JWT_SECRET=dapurgizi_jwt_secret_change_in_production
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=30d

# --- Midtrans (Sandbox) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Firebase FCM ---
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# --- Email (Brevo/SMTP) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dapurgizi.com

# --- App ---
APP_NAME=Dapur Gizi
APP_URL=http://localhost:3001
ADMIN_URL=http://localhost:3000
API_PORT=3001
ADMIN_WA=628xxxxxxxxxx
WAREHOUSE_WA=628xxxxxxxxxx

# --- OSRM & Nominatim (self-host URLs, use public for dev) ---
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
